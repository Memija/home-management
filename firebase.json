{
  "hosting": {
    "site": "home-management-be965",
    "public": "dist/home-management/browser",
    "ignore": [
      "firebase.json",
      "**/.git/**",
      "**/.github/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "same-origin"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(), geolocation=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            // --- Content-Security-Policy Breakdown ---
            //
            // [default-src] The ultimate fallback/catch-all for any resource type not explicitly defined below (like media or manifests).
            // It prevents the browser from defaulting to "allow everything" if a specific directive is missing:
            // - 'self' : Allow fallback resources from the app itself
            // - https://ko-fi.com : Allow fallback resources for the Ko-fi donation widget
            // - https://challenges.cloudflare.com : Allow fallback resources for Cloudflare Turnstile
            //
            // [base-uri] Restricts URLs that can appear in a document's <base> element:
            // - 'self' : Prevents base tag hijacking attacks
            //
            // [form-action] Restricts endpoints that can be used as the target of a form submission:
            // - 'self' : Only allow form submissions to the origin itself
            //
            // [frame-ancestors] Restricts who can embed this app in <iframe>, <frame>, or <object>:
            // - 'self' : Prevents clickjacking by untrusted sites (complements X-Frame-Options: SAMEORIGIN)
            //
            // [object-src] Restricts sources for legacy plugins (<object>, <embed>, <applet>):
            // - 'none' : Completely disable plugin execution
            //
            // [upgrade-insecure-requests] Instructs browsers to treat all HTTP requests as HTTPS requests
            //
            // [script-src] Allowed sources for JavaScript execution:
            // - 'self' : App's own JavaScript bundles
            // - 'unsafe-inline' : Required for Firebase Auth popup flows
            // - https://apis.google.com : Firebase Auth & Google Sign-In scripts
            // - https://accounts.google.com : Google Sign-In authentication flows
            // - https://www.gstatic.com : Firebase SDKs and Google widgets
            // - https://www.google.com/recaptcha/ : Firebase App Check reCAPTCHA v3
            // - https://www.gstatic.com/recaptcha/ : reCAPTCHA v3 static assets
            // - https://storage.ko-fi.com : Ko-fi widget dynamic scripts
            // - https://ko-fi.com : Ko-fi widget core scripts
            // - https://challenges.cloudflare.com : Cloudflare Turnstile CAPTCHA scripts
            //
            // [frame-src] Allowed sources for embedded iframes:
            // - 'self' : App's own iframes
            // - https://*.firebaseapp.com : Firebase Auth hidden iframes (e.g. __auth/iframe)
            // - https://accounts.google.com : Google Sign-In popup iframes
            // - https://www.google.com/recaptcha/ : reCAPTCHA v3 challenge iframes
            // - https://recaptcha.google.com/recaptcha/ : reCAPTCHA v3 challenge iframes
            // - https://ko-fi.com : Ko-fi donation embed iframe
            // - https://challenges.cloudflare.com : Cloudflare Turnstile challenge iframe
            //
            // [connect-src] Allowed URLs for API calls (Fetch, XHR, WebSockets):
            // - 'self' : App's own API endpoints
            // - https://*.firebaseio.com : Firebase Realtime Database (WebSockets/Polling)
            // - https://*.googleapis.com : Firebase Firestore and Auth APIs
            // - https://apis.google.com : Google API endpoints
            // - https://accounts.google.com : Google Auth token endpoints
            // - https://www.google.com/recaptcha/ : Firebase App Check reCAPTCHA verification
            // - https://*.firebaseapp.com : Firebase Hosting/Auth endpoints
            // - https://ko-fi.com : Ko-fi widget API requests
            // - https://challenges.cloudflare.com : Cloudflare Turnstile verification endpoints
            //
            // [style-src] Allowed sources for CSS stylesheets:
            // - 'self' : App's own global stylesheets
            // - 'unsafe-inline' : Required for Angular's dynamic component styles
            //
            // [font-src] Allowed sources for web fonts:
            // - 'self' : App's own local fonts
            //
            // [img-src] Allowed sources for images:
            // - 'self' : App's own local images
            // - data: : Base64 encoded inline images
            // - blob: : Locally generated image blobs (e.g., Meter Reader camera previews)
            // - https://*.googleapis.com : Google Maps or Avatar images
            // - https://*.googleusercontent.com : User profile pictures from Google Auth
            // - https://storage.ko-fi.com : Ko-fi widget UI images
            // - https://ko-fi.com : Ko-fi widget UI images
            // - https://*.cloudflare.com : Cloudflare Turnstile assets
            //
            // [worker-src] Allowed sources for Web Workers:
            // - 'self' : App's own local workers (e.g., Tesseract.js local files)
            // - blob: : Required by Tesseract.js to spawn background workers from memory
            "key": "Content-Security-Policy",
            "value": "default-src 'self' https://ko-fi.com https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://apis.google.com https://accounts.google.com https://www.gstatic.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://storage.ko-fi.com https://ko-fi.com https://challenges.cloudflare.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://ko-fi.com https://challenges.cloudflare.com; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com https://apis.google.com https://accounts.google.com https://www.google.com/recaptcha/ https://*.firebaseapp.com https://ko-fi.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.googleapis.com https://*.googleusercontent.com https://storage.ko-fi.com https://ko-fi.com https://*.cloudflare.com blob:; worker-src 'self' blob:;"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "same-origin"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      },
      {
        "source": "@(manifest.webmanifest|robots.txt|sitemap.xml)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=3600"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "cross-origin"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "same-origin"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "same-origin"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/.well-known/**",
        "destination": "/.well-known/**"
      },
      {
        "source": "**/.*",
        "destination": "/404.html"
      },
      {
        "source": "**/*.{env,json,yml,yaml,php,sql,bak,map,config,credentials}",
        "destination": "/404.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
