{
  "name": "home-management",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "config:generate": "node scripts/generate-firebase-config.js",
    "prestart": "npm run config:generate",
    "start": "ng serve home-management",
    "prebuild": "npm run config:generate",
    "build": "ng build home-management && copy dist\\home-management\\browser\\index.csr.html dist\\home-management\\browser\\index.html",
    "watch": "ng build home-management --watch --configuration development",
    "test": "ng test home-management",
    "pretest:coverage": "npm run config:generate",
    "test:coverage": "ng test home-management --coverage --coverage-reporters=lcovonly --coverage-reporters=text-summary --watch=false",
    "sonar": "sonar-scanner",
    "serve:ssr:home-management": "node dist/home-management/server/server.mjs",
    "test:lighthouse:mobile": "lhci autorun",
    "test:lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=./.lighthouseci/desktop",
    "test:lighthouse": "npm run test:lighthouse:mobile && npm run test:lighthouse:desktop",
    "test:lighthouse:flows": "node scripts/lighthouse-flow.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "validate": "npm run format:check && npm run lint && npm run build && npm run test:coverage && npm run test:lighthouse",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "21.2.18",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/platform-browser-dynamic": "21.2.18",
    "@angular/platform-server": "21.2.18",
    "@angular/router": "21.2.18",
    "@angular/ssr": "21.2.18",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "express": "^5.1.0",
    "firebase": "^12.9.0",
    "hammerjs": "^2.0.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-angular": "^0.555.0",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.18",
    "@angular/build": "21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.18",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "baseline-browser-mapping": "^2.9.17",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sonarqube-scanner": "^4.3.8",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8",
    "vitest-sonar-reporter": "^3.0.0",
    "zone.js": "^0.16.0"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{scss,json}": [
      "prettier --write"
    ]
  }
}
