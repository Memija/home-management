{
  "name": "home-management",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve home-management",
    "watch": "ng build home-management --watch --configuration development",
    "serve:ssr:home-management": "node dist/home-management/server/server.mjs",
    "config:generate": "node scripts/generate-firebase-config.js",
    "prestart": "npm run config:generate",
    "prewatch": "npm run config:generate",
    "prebuild": "npm run config:generate",
    "build": "ng build home-management && node scripts/copy-csr.js",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "pretest": "npm run config:generate",
    "pretest:coverage": "npm run config:generate",
    "test": "ng test home-management",
    "test:coverage": "ng test home-management --coverage --coverage-reporters=lcovonly --coverage-reporters=text-summary --watch=false",
    "test:lighthouse:mobile": "lhci autorun",
    "test:lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=./.lighthouseci/desktop",
    "test:lighthouse": "npm run test:lighthouse:mobile && npm run test:lighthouse:desktop",
    "test:lighthouse:flows": "node scripts/lighthouse-flow.mjs",
    "security:audit": "npm audit --audit-level=critical",
    "security:secrets": "node scripts/check-secrets.js",
    "security:socket": "npx -y @socketsecurity/cli scan",
    "security:sbom": "npx -y @cyclonedx/cyclonedx-npm --ignore-npm-errors --output-file cyclonedx.sbom.json",
    "security:trivy": "node scripts/run-security-scan.js trivy",
    "security:osv": "node scripts/run-security-scan.js osv",
    "security:gitleaks": "node scripts/run-security-scan.js gitleaks",
    "security:zizmor": "node scripts/run-security-scan.js zizmor",
    "security:dast": "node scripts/run-security-scan.js dast",
    "security:all": "node scripts/run-security-scan.js all",
    "audit:licenses": "license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;0BSD;Unlicense;Python-2.0\"",
    "validate": "npm run format:check && npm run lint && npm run security:secrets && npm run security:audit && npm run audit:licenses && npm run build && npm run test:coverage && npm run test:lighthouse",
    "sonar": "sonar-scanner",
    "prepare": "husky"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.22",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/platform-browser-dynamic": "^21.2.22",
    "@angular/platform-server": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@angular/ssr": "^21.2.22",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "firebase": "^12.9.0",
    "hammerjs": "^2.0.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-angular": "^0.555.0",
    "ng2-charts": "^8.0.0",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular/build": "^21.2.22",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sonarqube-scanner": "^5.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8",
    "vitest-sonar-reporter": "^3.0.0",
    "zone.js": "^0.16.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "tmp": "^0.2.6"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{scss,json}": [
      "prettier --write"
    ]
  }
}
