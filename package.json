{
  "name": "home-management",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve home-management",
    "watch": "ng build home-management --watch --configuration development",
    "build": "node scripts/generate-firebase-config.js && ng build home-management && node scripts/copy-csr.js",
    "serve:ssr": "node dist/home-management/server/server.mjs",
    "config:generate": "node scripts/generate-firebase-config.js",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "test": "node scripts/generate-firebase-config.js && ng test home-management",
    "test:coverage": "node scripts/generate-firebase-config.js && ng test home-management --coverage --coverage-reporters=lcovonly --coverage-reporters=text-summary --watch=false",
    "sonar:scan": "sonar-scanner-npm",
    "test:lighthouse": "npm run test:lighthouse:mobile && npm run test:lighthouse:desktop",
    "test:lighthouse:mobile": "lhci autorun --upload.outputDir=./.lighthouseci/mobile",
    "test:lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop --upload.outputDir=./.lighthouseci/desktop",
    "test:lighthouse:flows": "node scripts/lighthouse-flow.mjs",
    "test:lighthouse:flows:quick": "node scripts/lighthouse-flow.mjs --quick",
    "test:lighthouse:flows:desktop": "node scripts/lighthouse-flow.mjs --desktop",
    "test:lighthouse:flows:desktop:light": "node scripts/lighthouse-flow.mjs --desktop --light",
    "test:lighthouse:flows:desktop:dark": "node scripts/lighthouse-flow.mjs --desktop --dark",
    "test:lighthouse:flows:mobile": "node scripts/lighthouse-flow.mjs --mobile",
    "test:lighthouse:flows:mobile:light": "node scripts/lighthouse-flow.mjs --mobile --light",
    "test:lighthouse:flows:mobile:dark": "node scripts/lighthouse-flow.mjs --mobile --dark",
    "security:all": "node scripts/run-security-scan.js all",
    "security:audit": "npm audit --audit-level=critical",
    "security:secrets": "node scripts/check-secrets.js",
    "security:gitleaks": "node scripts/run-security-scan.js gitleaks",
    "security:osv": "node scripts/run-security-scan.js osv",
    "security:sbom": "cyclonedx-npm --ignore-npm-errors --output-file cyclonedx.sbom.json",
    "security:trivy": "node scripts/run-security-scan.js trivy",
    "security:zizmor": "node scripts/run-security-scan.js zizmor",
    "audit:licenses": "license-checker-rseidelsohn --production --summary --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;0BSD;Unlicense;Python-2.0\"",
    "predeploy": "npm run build",
    "deploy": "firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore:rules",
    "validate": "npm run format:check && npm run lint && npm run security:gitleaks && npm run security:audit && npm run audit:licenses && npm run build && npm run test:coverage && npm run test:lighthouse",
    "prepare": "husky"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/platform-server": "^21.2.25",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^21.2.27",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "firebase": "^12.19.0",
    "hammerjs": "^2.0.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-angular": "^1.0.0",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.2",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.27",
    "@angular/build": "^21.2.27",
    "@angular/cdk": "^21.2.14",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sonarqube-scanner": "^5.0.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11",
    "vitest-sonar-reporter": "^3.0.0",
    "zone.js": "^0.16.3"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "qs": "^6.16.0",
    "tmp": "^0.2.6",
    "js-yaml": "^3.15.2",
    "rxfire": {
      "firebase": "$firebase"
    },
    "@noble/hashes": "^1.8.0",
    "piscina": "^5.3.2",
    "proxy-addr": "^2.0.8",
    "shell-quote": "^1.12.0",
    "dompurify": "^3.4.17",
    "source-map-js": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sprintf-js": "^1.1.3",
    "ip-address": "^10.7.4",
    "http-cache-semantics": "^4.3.0",
    "follow-redirects": "^1.16.1",
    "brace-expansion": "^5.0.12",
    "undici": "^7.30.1",
    "@grpc/grpc-js": "^1.14.6",
    "fast-uri": "^3.1.9",
    "basic-ftp": "^6.2.3",
    "webpack-dev-middleware": "^7.4.6",
    "vite": "^7.3.7"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{scss,json}": [
      "prettier --write"
    ]
  }
}
