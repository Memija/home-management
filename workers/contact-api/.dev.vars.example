# Local `wrangler dev` overrides (`workers/contact-api/.dev.vars` is gitignored and never deployed).
# In production, set `CONTACT_TO_EMAIL` once via:
#   npx wrangler secret put CONTACT_TO_EMAIL --config workers/contact-api/wrangler.toml
ALLOW_LOCALHOST_ORIGIN=true
CONTACT_TO_EMAIL=your-verified-destination@example.com

# Optional overrides:
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=
